# Copy this file to .env (local dev) and configure the same keys as
# environment variables in your hosting provider (Vercel, Netlify, etc.)
# for production. Never commit a real .env file.

# Base URL of the backend API (no trailing slash, no /api suffix)
REACT_APP_BACKEND_URL=https://your-backend.example.com

# Google OAuth client ID used for "Sign in with Google"
REACT_APP_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
